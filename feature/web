import ephyra.presentation.core.util.system.toShareIntent
import ephyra.presentation.core.util.system.toast

@Composable
fun WebViewScreen(
    url: String,
    initialTitle: String? = null,
    sourceId: Long? = null,
    navController: NavController = LocalNavController.current,
) {
    val context = LocalContext.current
    val viewModel = hiltViewModel<WebViewViewModel>()

    LaunchedEffect(viewModel, sourceId) {
        viewModel.initialize(sourceId)
    }

@Composable
fun WebViewScreen(
    url: String,
    initialTitle: String? = null,
    sourceId: Long? = null,
    navController: NavController = LocalNavController.current,
) {
    val context = LocalContext.current
    val viewModel = hiltViewModel<WebViewViewModel>()

    LaunchedEffect(viewModel, sourceId) {
        viewModel.initialize(sourceId)
    }

    LaunchedEffect(viewModel) {
        viewModel.effects.collect { effect ->
            when (effect) {
                is WebViewEffect.OpenInBrowser -> {
                    context.openInBrowser(effect.url)
                }
                is WebViewEffect.ShareUrl -> {
                    val intent = context.toShareIntent(effect.url, effect.title)
                    context.startActivity(intent)
                }
                is WebViewEffect.ShowToast -> {
                    context.toast(effect.message)
                }
            }
        }
    }
}