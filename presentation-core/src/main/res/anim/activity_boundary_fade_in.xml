<?xml version="1.0" encoding="utf-8"?>
<!--
    The activity boundary's open animation: a pure crossfade, nothing moves.

    Part of Theme.Tachiyomi.ActivityBoundary (owner directive 2026-11-09: the reader and WebView
    boundaries get a minimal crossfade instead of the system's zooming reveal, which read as
    elements flying around). Alpha only — no transform properties at all — so the boundary
    cannot introduce movement. Duration and interpolator match MotionPolicy's crossfade token
    (CROSSFADE_DURATION_MILLIS = 200, fast-out-slow-in); MotionConsistencyTest asserts both.
-->
<alpha
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="200"
    android:fromAlpha="0.0"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:toAlpha="1.0" />
